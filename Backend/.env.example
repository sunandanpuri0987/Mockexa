# Copy to .env and fill in real values. Never commit the real .env file.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_RETRIES=3

GEMINI_MAX_INPUT_TOKENS=4000
GEMINI_MAX_OUTPUT_TOKENS=512

GD_GENERATION_MAX_INPUT_TOKENS=3000
GD_GENERATION_MAX_OUTPUT_TOKENS=220

TECHNICAL_EVAL_MAX_INPUT_TOKENS=2500
TECHNICAL_EVAL_MAX_OUTPUT_TOKENS=300

HR_EVAL_MAX_INPUT_TOKENS=2500
HR_EVAL_MAX_OUTPUT_TOKENS=450

FEEDBACK_MAX_INPUT_TOKENS=3500
FEEDBACK_MAX_OUTPUT_TOKENS=400

PREPAI_ENV=development

# Server
HOST=0.0.0.0
PORT=8000

# CORS — comma-separated origins, or * for development
CORS_ORIGINS=*

# Gemini Toggle — Technical, HR, and GD reasoning use Gemini by default
USE_GEMINI=True

# Auth — Supabase JWKS verification
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Auth fallback — Supabase JWT secret (for local HS256 testing, or legacy projects)
SUPABASE_JWT_SECRET=

# Feature flags
USE_SUPABASE_PERSISTENCE=False

# The opening turn contains no user claim, so disabling its second LLM pass
# makes a new GD begin much faster. Later turns are always verified.
GD_VERIFY_OPENING_TURN=False

# ElevenLabs Neural TTS Configuration
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
TTS_CACHE_TTL_SECONDS=3600
TTS_CACHE_MAX_ENTRIES=128
ELEVENLABS_VOICE_MAYA=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_JORDAN=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_ARJUN=ErXwobaYiN019PkySvjV
ELEVENLABS_VOICE_ELENA=MF3mGyEYCl7XYWbV9V6O
ELEVENLABS_VOICE_HR=XrExE9yKIg1WjnnlVkGX

# Optional secondary neural TTS provider; EdgeTTS is the final fallback.
OPENAI_API_KEY=
